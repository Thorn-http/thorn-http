{
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "manifest_version": 3,
  "incognito": "spanning",
  "update_URL": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",
  "content_scripts": [
    {
      "matches": ["https://thorn-http.dev/*"],
      "js": ["app.cs.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["client.cs.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://thorn-http.dev/r", "https://thorn-http.dev/r/", "https://thorn-http.dev/r.html"],
      "js": ["ruleLink.cs.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "serviceWorker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["resources/images/128x128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": "resources/images/128x128.png",
    "default_title": "__MSG_extIconTitle__",
    "default_popup": "popup/popup.html"
  },
  "devtools_page": "devtools/devtools.html",
  "icons": {
    "16": "resources/images/16x16.png",
    "48": "resources/images/48x48.png",
    "128": "resources/images/128x128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; script-src-elem 'self'; object-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "delay_rules",
        "enabled": true,
        "path": "resources/static-rules/delayRules.json"
      },
      {
        "id": "header_rules",
        "enabled": true,
        "path": "resources/static-rules/headerRules.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "sidepanel/network-recording/index.html"
  },
  "permissions": [
    "alarms",
    "browsingData",
    "contextMenus",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {}
}
