# Default (non-extension) app build. Thorn HTTP ships the extension build (see .env.extension),
# which uses no backend; these values are placeholders only.
VITE_BACKEND_ENV="prod"
VITE_GENERATE_SOURCEMAP="false"

VITE_REACT_APP_FIREBASE_API_KEY="thorn-local-no-backend"
VITE_REACT_APP_FIREBASE_AUTH_DOMAIN="localhost"
VITE_REACT_APP_FIREBASE_DATABASE_URL="https://thorn-local.firebaseio.com"
VITE_REACT_APP_FIREBASE_PROJECT_ID="thorn-local"
VITE_REACT_APP_FIREBASE_STORAGE_BUCKET=""
VITE_REACT_APP_FIREBASE_MESSAGING_SENDER_ID=""

VITE_REACT_APP_VERSION=$npm_package_version
