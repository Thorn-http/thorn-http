# Build used when the app is bundled inside the THorn HTTP extension: no backend, no third-party services.
VITE_THORN_EXTENSION="true"
VITE_BACKEND_ENV="prod"
VITE_GENERATE_SOURCEMAP="false"

# Placeholder Firebase config so the SDK initializes; nothing is ever signed in or synced.
VITE_REACT_APP_FIREBASE_API_KEY="thorn-local-no-backend"
VITE_REACT_APP_FIREBASE_AUTH_DOMAIN="localhost"
VITE_REACT_APP_FIREBASE_DATABASE_URL="https://thorn-local.firebaseio.com"
VITE_REACT_APP_FIREBASE_PROJECT_ID="thorn-local"
VITE_REACT_APP_FIREBASE_STORAGE_BUCKET=""
VITE_REACT_APP_FIREBASE_MESSAGING_SENDER_ID=""

VITE_REACT_APP_STRIPE_PUBLISHABLE_KEY=""
VITE_GROWTHBOOK_CLIENT_KEY=""
VITE_BACKEND_BASE_URL=""
VITE_BACKEND_FUNCTION_BASE_URL=""
VITE_BROWSERSTACK_BASE_URL=""
VITE_REACT_APP_EDS_SERVER=""
VITE_REACT_APP_EDS_API_KEY=""
VITE_REACT_APP_VERSION=$npm_package_version
