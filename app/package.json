{
  "name": "@thorn-http/app",
  "version": "26.8.14",
  "private": true,
  "description": "Thorn HTTP - Lightweight Proxy to Intercept & Modify HTTP(s) requests",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleberpereiradasilva/thorn-request.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://thorn-http.dev/issues"
  },
  "author": {
    "name": "Thorn HTTP contributors",
    "url": "https://thorn-http.dev"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "test": "vitest --passWithNoTests",
    "lint": "eslint --fix --ext .js,.jsx .",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "build:emulator": "vite build --mode dev-emulator",
    "build:extension": "vite build --mode extension",
    "preview": "npm run build && vite preview --port 3000",
    "preview:emulator": "npm run build:emulator && vite preview --port 3000",
    "dev": "concurrently --kill-others --names \"@thorn-http/shared, @requestly/app\" \"cd ../shared && npm run watch\" \"vite\"",
    "dev:emulator": "concurrently --kill-others --names \"@thorn-http/shared, @requestly/app\" \"cd ../shared && npm run watch\" \"vite --mode dev-emulator\"",
    "start": "concurrently --kill-others --names \"@thorn-http/shared, @requestly/app\" \"cd ../shared && npm run watch\" \"vite\"",
    "start:emulator": "concurrently --kill-others --names \"@thorn-http/shared, @requestly/app\" \"cd ../shared && npm run watch\" \"vite --mode dev-emulator\"",
    "//": "****Deprecated****",
    "emulated-dev": "concurrently --kill-others --names \"@thorn-http/shared, @requestly/app\" \"cd ../shared && npm run watch\" \"vite --mode dev-emulator\"",
    "emulated-start": "vite --mode dev-emulator"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "eslintConfig": {
    "extends": "react-app"
  },
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
    "@ant-design/pro-card": "^1.20.6",
    "@babel/parser": "^7.26.0",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lint": "^6.8.1",
    "@codemirror/merge": "^6.11.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@growthbook/growthbook-react": "^1.3.1",
    "@prettier/plugin-xml": "^2.2.0",
    "@react-icons/all-files": "https://github.com/react-icons/react-icons/releases/download/v5.4.0/react-icons-all-files-5.4.0.tgz",
    "@reduxjs/toolkit": "^1.9.0",
    "@requestly/alternative-importers": "^0.2.1",
    "@sentry/react": "^10.32.1",
    "@stripe/react-stripe-js": "^2.3.0",
    "@stripe/stripe-js": "^1.24.0",
    "@thorn-http/core": "file:..",
    "@thorn-http/shared": "file:../shared",
    "@uiw/codemirror-theme-vscode": "^4.22.1",
    "@uiw/react-codemirror": "4.22.1",
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.2",
    "antd": "^4.24.16",
    "codemirror": "^6.0.2",
    "codemirror-json5": "^1.0.3",
    "curlconverter": "^4.12.0",
    "fflate": "^0.7.3",
    "firebase": "^10.8.1",
    "framer-motion": "^10.16.16",
    "graphiql-explorer": "^0.9.0",
    "html-validate": "^8.9.1",
    "is-empty": "^1.2.0",
    "js-file-download": "^0.4.12",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "lottie-web": "^5.10.0",
    "md5": "^2.3.0",
    "moment": "^2.29.1",
    "pako": "^2.1.0",
    "prettier": "^2.8.1",
    "re2js": "^0.4.1",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-dropzone": "^12.0.4",
    "react-hotkeys-hook": "^4.5.1",
    "react-joyride": "^2.5.3",
    "react-medium-image-zoom": "^5.1.3",
    "react-notion": "^0.10.0",
    "react-redux": "^8.0.2",
    "react-resizable": "^3.0.4",
    "react-router-dom": "6.14.1",
    "react-select": "^5.2.2",
    "react-split": "^2.0.14",
    "reactstrap": "9.0.1",
    "redux-deep-persist": "^1.0.6",
    "redux-persist": "^6.0.0",
    "semver": "^7.5.4",
    "styled-components": "^6.1.8",
    "ua-parser-js": "^1.0.2",
    "uuid": "^8.3.2",
    "vscode-json-languageservice": "^5.3.6",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageserver-types": "^3.17.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@requestly-ui/resource-table": "^0.1.8",
    "@requestly/web-sdk": "^0.15.1",
    "@sentry/vite-plugin": "^2.22.7",
    "@types/chai": "^5.0.1",
    "@types/chrome": "^0.0.217",
    "@types/file-saver": "^2.0.5",
    "@types/lodash": "^4.14.185",
    "@types/papaparse": "^5.3.16",
    "@types/prettier": "^3.0.0",
    "@types/react-dom": "^18.2.8",
    "@types/react-redux": "^7.1.25",
    "@types/react-resizable": "^3.0.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "^7.3.13",
    "@types/ua-parser-js": "^0.7.36",
    "@types/uuid": "^9.0.8",
    "@types/xml2js": "^0.4.11",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "esbuild": "0.20.1",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "less": "^4.2.0",
    "patch-package": "^8.0.0",
    "sass": "^1.58.3",
    "source-map-loader": "^3.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.1.4",
    "vite-plugin-commonjs": "^0.10.1",
    "vite-plugin-node-polyfills": "^0.21.0",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.3.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!antd|@ant-design|rc-.+?|@babel/runtime).+(js|jsx)$"
    ]
  }
}
